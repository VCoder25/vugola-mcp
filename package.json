{
  "name": "vugola-mcp",
  "version": "1.4.0",
  "mcpName": "io.github.VCoder25/vugola-mcp",
  "description": "Official Vugola MCP for clipping videos, burning captions, and scheduling posts from any MCP client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vugola-mcp": "dist/index.js",
    "vugola-mcp-install": "dist/install-bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/test-client.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "mcp",
    "vugola",
    "video",
    "clipping",
    "ai",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/VCoder25/vugola-mcp.git"
  },
  "license": "MIT"
}
