{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.VCoder25/vugola-mcp",
  "description": "Clip videos into captioned shorts, add captions, and schedule posts from AI agents.",
  "title": "Vugola",
  "repository": {
    "url": "https://github.com/VCoder25/vugola-mcp",
    "source": "github"
  },
  "version": "1.4.1",
  "websiteUrl": "https://www.vugolaai.com/mcp",
  "icons": [
    {
      "src": "https://www.vugolaai.com/integrations/vugola-mark.png",
      "mimeType": "image/png",
      "sizes": ["1024x1024"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "vugola-mcp",
      "version": "1.3.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VUGOLA_API_KEY",
          "description": "Your Vugola API key (prefix vug_sk_). Get one at https://www.vugolaai.com/dashboard/api-key. Requires an active paid Vugola plan.",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.vugolaai.com/api/mcp"
    }
  ]
}
